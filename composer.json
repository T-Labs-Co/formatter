{
    "name": "t-labs-co/formatter",
    "description": "A powerful data formatting package for Laravel — apply chainable format rules to transform, clean, and normalize data values.",
    "keywords": [
        "t-labs-co",
        "ty-huynh",
        "laravel",
        "formatter",
        "data-formatting",
        "string-formatting",
        "data-transformation"
    ],
    "homepage": "https://github.com/T-Labs-Co/formatter",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ty Huynh",
            "email": "hongty.huynh@gmail.com",
            "homepage": "https://tyhuynh.id.vn",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12|^13",
        "illuminate/support": "^12|^13"
    },
    "require-dev": {
        "larastan/larastan": "^3",
        "laravel/pint": "^1",
        "orchestra/testbench": "^10|^11",
        "pestphp/pest": "^4|^5",
        "pestphp/pest-plugin-laravel": "^4|^5"
    },
    "autoload": {
        "psr-4": {
            "TLabsCo\\Formatter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TLabsCo\\Formatter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --parallel",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TLabsCo\\Formatter\\Providers\\FormatterServiceProvider"
            ],
            "aliases": {
                "Formatter": "TLabsCo\\Formatter\\Facades\\Formatter"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
